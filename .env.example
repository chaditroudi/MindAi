LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_SUPERVISOR_MODEL=llama3.2:3b
OLLAMA_MONGODB_MODEL=llama3.2:3b
OLLAMA_SEARCH_MODEL=llama3.2:3b
OLLAMA_WRITER_MODEL=llama3.2:3b
OLLAMA_CHART_MODEL=llama3.2:3b

# Optional Groq provider. Keep LLM_PROVIDER=ollama for local Ollama models.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

DB_URL=mongodb://127.0.0.1:27017/mind_platform
MONGODB_URI=mongodb://127.0.0.1:27017/mind_platform
MONGODB_DB=mind_platform
SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_API_KEY=
KNOWLEDGE_COLLECTION=knowledge_chunks
KNOWLEDGE_TENANT_ID=_shared
KNOWLEDGE_SHARED_TENANT_ID=_shared

PORT=3000
NODE_ENV=development
SMOKE_BASE_URL=http://localhost:3000

MASTRA_TELEMETRY_DISABLED=true
SUPERVISOR_TIMEOUT_MS=30000
WRITER_TIMEOUT_MS=30000
OPTIONAL_AGENT_TIMEOUT_MS=3000
META_GENERATION_TIMEOUT_MS=30000
WORKFLOW_TIMEOUT_MS=90000
MONGODB_AGENT_AUDIT=false
