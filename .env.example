# ─── LLM ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# Default model for all roles. Override per-role with the vars below.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional per-role model overrides (uncomment to use)
# GROQ_SUPERVISOR_MODEL=llama-3.1-8b-instant   # faster/cheaper for planning
# GROQ_CHART_MODEL=llama-3.3-70b-versatile
# GROQ_WRITER_MODEL=llama-3.3-70b-versatile

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/mind_platform
MONGODB_DB=mind_platform

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# Comma-separated allowed CORS origins (leave empty to allow all)
# ALLOWED_ORIGINS=https://your-frontend.com
# Bearer token for API authentication (optional)
# API_KEY=your_secret_key_here

# ─── LLM timeouts (ms) ────────────────────────────────────────────────────────
SUPERVISOR_TIMEOUT_MS=8000
CHART_TIMEOUT_MS=8000
WRITER_TIMEOUT_MS=8000

# ─── Chart tuning (optional) ──────────────────────────────────────────────────
# CHART_MAX_WIDGETS=4      # max charts per dashboard response
# CHART_MAX_TOKENS=1500    # token budget for chart LLM call
# CHART_SAMPLE_ROWS=8      # rows shown to LLM as data sample
# CHART_PROFILE_ROWS=30    # rows used for column profiling

# ─── Writer tuning (optional) ─────────────────────────────────────────────────
# INQUIRY_MAX_TOKENS=512
# INQUIRY_MAX_ROWS=10
# REPORT_MAX_TOKENS=2048
# WRITER_MAX_CHARS=8000
