LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_SUPERVISOR_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MONGODB_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_SEARCH_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_WRITER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_CHART_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional Groq provider. Set LLM_PROVIDER=groq to use it.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

DB_URL=mongodb://127.0.0.1:27017/mind_platform
MONGODB_URI=mongodb://127.0.0.1:27017/mind_platform
MONGODB_DB=mind_platform
KNOWLEDGE_COLLECTION=knowledge_chunks
KNOWLEDGE_TENANT_ID=_shared
KNOWLEDGE_SHARED_TENANT_ID=_shared

PORT=3000
NODE_ENV=development
SMOKE_BASE_URL=http://localhost:3000

MASTRA_TELEMETRY_DISABLED=true
SUPERVISOR_TIMEOUT_MS=30000
WRITER_TIMEOUT_MS=30000
OPTIONAL_AGENT_TIMEOUT_MS=3000
META_GENERATION_TIMEOUT_MS=30000
WORKFLOW_TIMEOUT_MS=90000
MONGODB_AGENT_AUDIT=false
