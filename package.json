{
  "name": "mind-viz-agents",
  "version": "0.1.0",
  "description": "Multi-agent data visualization system for a configurable Mind Platform — Mastra.js orchestration of Supervisor, MongoDB, Search, and Chart agents.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "mastra:dev": "mastra dev",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "smoke": "tsx scripts/smoke.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:wait": "node -e \"setTimeout(() => process.exit(0), 5000)\"",
    "db:reset": "npm run db:down -- -v && npm run db:up && npm run db:wait && npm run seed"
  },
  "dependencies": {
    "@mastra/core": "^0.10.0",
    "@mastra/memory": "^0.10.0",
    "@ai-sdk/openai": "^1.0.0",
    "mongodb": "^6.10.0",
    "zod": "^3.23.8",
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.0.0",
    "mastra": "^0.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
