{
  "name": "mind-viz-agents",
  "version": "0.1.0",
  "description": "Datastore-driven analytics service for Mind Platform with Mastra Supervisor, MongoDB, Search, Writer, and deterministic chart runtime.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "start": "node dist/server.js",
    "reset": "tsx scripts/reset.ts",
    "mastra:dev": "mastra dev",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.0.0",
    "@mastra/core": "^0.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mongodb": "^6.10.0",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "mastra": "^0.10.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
